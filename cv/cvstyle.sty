% =====================================================================
%  cvstyle.sty  --  shared layout for every version of the CV
%  Every version loads this file, so a style change here applies to all
%  of them. Shared facts (name, contact, GPA) live in cvdata.tex; all
%  other content lives in the individual version files.
%
%  Layout rules this file enforces (Harvard GSAS + Cambridge Careers):
%   * one serif font, body 10.5pt-11pt, never below 10pt
%   * headings in small caps with a thin rule; no boxes, shading, underlining
%   * key information (role, institution) on the LEFT, dates and places on
%     the RIGHT -- readers skim the left edge in an "F" pattern
%   * one bullet style, no nested bullets
%   * name + "page x of y" in the footer so loose pages can be re-ordered
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/09/29 shared CV layout]

% ---- Fonts & encoding -------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{charter}       % Bitstream Charter; swap for XCharter, newtxtext, etc.
\RequirePackage[protrusion=true,expansion=false]{microtype}

% ---- Page -------------------------------------------------------------
% Paper size comes from the \documentclass option of each CV
% (a4paper for UK applications, letterpaper for US ones).
\RequirePackage[margin=0.8in,top=0.7in,bottom=0.8in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks]{hyperref}

\definecolor{cvrule}{gray}{0.55}
\definecolor{cvph}{gray}{0.55}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedbottom
\urlstyle{same}

% ---- Keeping blocks together -----------------------------------------
% \cvneed{<height>} starts a new page only if less than <height> is left
% on this one. (The needspace package does the same job but also invites
% a page break at every call, which left pages ending early.)
\makeatletter
\newcommand{\cvneed}[1]{\par\begingroup
  \dimen@=#1\relax \dimen@ii=\pagegoal \advance\dimen@ii by -\pagetotal
  \ifdim\dimen@>\dimen@ii \ifdim\dimen@ii>\z@ \vfil\break \fi\fi
  \endgroup}
\makeatother

% ---- Placeholders -----------------------------------------------------
% \ph{...} prints grey text. Replace each \ph{...} with real content as
% you fill the skeleton; any grey left in the PDF is still unfilled.
\newcommand{\ph}[1]{\textcolor{cvph}{[#1]}}

% ---- Footer -----------------------------------------------------------
% \cvname and \cvupdated are set in each CV file.
\newcommand{\cvname}{Name}
\newcommand{\cvupdated}{\today}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\cvname\ \textperiodcentered\ Curriculum Vitae\ \textperiodcentered\ \cvupdated}
\fancyfoot[R]{\footnotesize Page \thepage\ of \pageref*{LastPage}}

% ---- Header -----------------------------------------------------------
% \cvheader{Name}{contact line}
\newcommand{\cvheader}[2]{%
  \begin{center}
    {\LARGE\bfseries #1}\par\vspace{3pt}
    {\small #2}
  \end{center}\vspace{-4pt}}
\newcommand{\sep}{\enspace\textperiodcentered\enspace}

% ---- Section headings -------------------------------------------------
% \section{...}     main heading, small caps + rule
% \cvsubsection{..} a labelled group inside a section (e.g. research areas)
\titleformat{\section}{\cvneed{6\baselineskip}\normalsize\scshape\bfseries}{}{0pt}{}[\vspace{-6pt}\textcolor{cvrule}{\rule{\linewidth}{0.5pt}}]
\titlespacing*{\section}{0pt}{9pt}{4pt}
\newcommand{\cvsubsection}[1]{\par\cvneed{4\baselineskip}\vspace{3pt}{\small\itshape #1}\par\nopagebreak\vspace{1pt}}

% ---- Entries ----------------------------------------------------------
% \entry{Role or degree}{Dates}{Institution / PI / unit}{Place}
%   Role bold on line 1, dates flush right; institution on line 2, place right.
%   The two lines are set separately, so a long date does not squeeze line 2.
%   Leave #3 and #4 empty for a one-line entry.
\newcommand{\entry}[4]{%
  \par\cvneed{3\baselineskip}\vspace{3pt}\noindent
  \begin{tabularx}{\linewidth}{@{}X@{\hspace{1em}}r@{}}\textbf{#1} & #2\end{tabularx}%
  \if\relax\detokenize{#3}\relax\else
    \par\nopagebreak\nointerlineskip\vspace{1pt}\noindent
    \begin{tabularx}{\linewidth}{@{}X@{\hspace{1em}}r@{}}#3 & #4\end{tabularx}%
  \fi\par}

% \oneline{Text}{Date}  -- compact single-line item (awards, service, etc.)
\newcommand{\oneline}[2]{%
  \par\vspace{1.5pt}\noindent
  \begin{tabularx}{\linewidth}{@{}X@{\hspace{1em}}r@{}}#1 & #2\end{tabularx}\par}

% Bullets under an entry: one style only, no nesting.
\newlist{cvitems}{itemize}{1}
\setlist[cvitems]{label=\textbullet, leftmargin=1.2em, labelsep=0.5em,
  topsep=1pt, itemsep=0pt, parsep=0pt, partopsep=0pt}

% ---- Publications -----------------------------------------------------
% \begin{publist} \item ... \end{publist}  -- numbered [1], [2], ...
% \me{K. Singh}   bolds your name in author lists
% \status{...}    Published / Under review / In preparation
% \contrib{...}   one line stating YOUR contribution (important on
%                 multi-author papers where you are not first author)
\newlist{publist}{enumerate}{1}
\setlist[publist]{label={[\arabic*]}, leftmargin=2.2em, labelsep=0.5em,
  topsep=2pt, itemsep=3pt, parsep=0pt}
\newcommand{\me}[1]{\textbf{#1}}
\newcommand{\status}[1]{\textsc{#1}}
\newcommand{\contrib}[1]{\par{\small\emph{Contribution:} #1}}

% ---- Presentations ----------------------------------------------------
% \pres{Authors}{Title}{Venue list}
%   One item per piece of work; list every venue where it was shown on
%   one line, instead of repeating the title for each venue.
\newcommand{\pres}[3]{%
  \par\vspace{3pt}\noindent #1. ``#2.''\par\nopagebreak
  \noindent\hspace{1.2em}\parbox{\dimexpr\linewidth-1.2em}{\small #3}\par}

% ---- Modules ----------------------------------------------------------
% \begin{modules} \item[Area] module; \key{key module}; ... \end{modules}
%   A compact block, not bullets. Area labels are italic, so bold is left
%   for \key{...}: the one or two modules per row a reader must not miss.
%   Keep bold rare. If most of a row is bold, none of it stands out.
\newlist{modules}{description}{1}
\setlist[modules]{before={\small\setlength{\emergencystretch}{2em}}, font=\normalfont\small\itshape, style=multiline,
  leftmargin=8.4em, labelwidth=7.9em, labelsep=0.5em,
  topsep=2pt, itemsep=0pt, parsep=0pt}
\newcommand{\key}[1]{\textbf{#1}}

% ---- Skills -----------------------------------------------------------
% \begin{skills} \item[Label] items... \end{skills}
\newlist{skills}{description}{1}
\setlist[skills]{font=\normalfont\bfseries, leftmargin=0pt, labelsep=0.4em,
  topsep=2pt, itemsep=1pt, parsep=0pt}

\endinput
